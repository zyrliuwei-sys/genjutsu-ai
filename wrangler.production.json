{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everygenai",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://everygenai.org",
    "VITE_APP_NAME": "Genjutsu AI",
    "VITE_APP_DESCRIPTION": "Genjutsu AI is an AI video generator and AI image generator for creators, short-video teams and marketers.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everygenai",
      "database_id": "4403c8fc-9fab-4703-8bb3-3b843ad0ad55",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [{ "pattern": "everygenai.org", "custom_domain": true }]
}
